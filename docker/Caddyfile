{$APP_DOMAIN:localhost} {
    reverse_proxy app:3000

    header {
        X-Robots-Tag "noindex, nofollow"
        -Server
    }

    request_body {
        max_size 500MB
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50MiB
            roll_keep 5
        }
    }
}
